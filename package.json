{
  "name": "putzflow",
  "version": "0.1.1",
  "private": true,
  "description": "Putzflow — Reinigungsplanung für Ferienwohnungs-Vermieter (Multi-Tenant, PWA)",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "rm -f /tmp/putzflow-*-test.sqlite /tmp/putzflow-test.sqlite && DB_FILE=/tmp/putzflow-test.sqlite node --test --test-concurrency=1 'test/*.test.js'",
    "check": "node --check server.js && for f in src/*.js src/notify/*.js public/*.js; do node --check \"$f\" || exit 1; done"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "nodemailer": "^9.0.3",
    "pdfkit": "^0.19.1"
  },
  "engines": {
    "node": ">=22.5"
  },
  "devDependencies": {
    "playwright": "^1.62.0"
  }
}
