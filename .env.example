# --- Basis ---
PORT=3990
# ⚠️ Standard ist 127.0.0.1: Der Server erwartet einen Webserver (nginx) davor.
# Nur setzen, wenn ohne Proxy im eigenen Netz getestet wird — z. B. HOST=0.0.0.0
# HOST=127.0.0.1
# ⚠️ DEINE Adresse, nicht unsere. Sie steht in jedem Link, den deine
# Reinigungskraefte per Mail bekommen — bleibt hier putzflow.de stehen, zeigen
# die Links auf einen fremden Server, auf dem es deinen Betrieb nicht gibt.
# Und sie bestimmt, unter welcher Domain Subdomains als Betrieb gelten.
BASE_URL=https://deine-domain.de
DB_FILE=data/putzflow.sqlite

# ⚠️ PFLICHT — ohne diesen Schlüssel startet Putzflow nicht.
# Einmal erzeugen, danach NIEMALS ändern: Er verschlüsselt die Smoobu-Zugänge der
# Mandanten (AES-256-GCM). Ein neuer Schlüssel macht alle unbrauchbar, ohne
# Fehlermeldung. Er gehört in die Sicherung.
#     echo "APP_SECRET=$(openssl rand -hex 32)" >> .env
APP_SECRET=

# Mandanten-Auflösung: <slug>.putzflow.de -> tenant.slug
# Apex/www zeigen die Landing-Page.
#
# ⚠️ Als Mandant gilt eine Subdomain NUR unter der Domain aus BASE_URL (bzw. aus
# TENANT_DOMAINS). Sonst würde jeder fremde mehrteilige Hostname als Betrieb
# gelesen — ein Tailnet-Name wie `side.tailf271ca.ts.net` ergäbe den Mandanten
# „side", und die Instanz antwortete mit „Unbekannter Mandant".
# Mehrere Domains kommagetrennt:
# TENANT_DOMAINS=putzflow.de,putzflow.com
#
# Eine Instanz = ein Betrieb (Zugriff über IP, Tailnet-Namen oder localhost, also
# ohne Subdomain): Dann gilt fest dieser Mandant. Die Ersteinrichtung trägt die
# Zeile selbst ein.
# DEFAULT_TENANT=demo

# --- Benachrichtigungen ---
# Kommagetrennt, in Reihenfolge der Bevorzugung:
#   console  nichts verschicken, alles ins Protokoll (Entwicklung)
#   mail     Brevo (API-Schlüssel unten)
#   smtp     ein beliebiger Mailserver (Block darunter)
#
# „mail" und „smtp" zusammen ist der EMPFOHLENE Betrieb: Der vordere verschickt,
# der hintere fängt auf, wenn das fehlschlägt. Beim Start wird gesagt, welcher
# gerade vorn steht — sonst trägt man SMTP ein, verschickt weiter über Brevo und
# sucht lange nach dem Grund.
# ⚠️ Beim Ausweichen kann eine Nachricht doppelt ankommen, wenn die Verbindung
# abbricht, NACHDEM der erste Server sie angenommen hat. Bewusst in Kauf
# genommen: eine doppelte Terminanfrage ist ein Ärgernis, eine ausgefallene
# Reinigung ein Schaden.
NOTIFY_CHANNELS=console
NOTIFY_FROM_NAME=Putzflow
# ⚠️ Absender aus DEINER Domain. Fuer eine fremde Domain hast du kein SPF/DKIM —
# die Mails landen im Spam oder werden abgewiesen, und die Reinigung faellt aus,
# ohne dass jemand etwas merkt.
NOTIFY_FROM_EMAIL=no-reply@deine-domain.de
# Alle Mails/Nachrichten stattdessen hierhin (Testphase). Vor Go-Live LEER lassen!
NOTIFY_REDIRECT_TO=

# Brevo — transaktionale Mail von der eigenen Subdomain mail.putzflow.de
BREVO_API_KEY=

# --- SMTP (NOTIFY_CHANNELS=smtp) -------------------------------------------
# Jeder Mailserver: eigener, Postmark, Mailgun, Resend, der des Hosters.
# Ein Vorteil gegenüber Brevo: Die Kalendereinladung kommt als echte Einladung
# an (method=REQUEST), nicht als Dateianhang.
#
# ⚠️ Port 465 spricht sofort TLS, 587 beginnt im Klartext und schaltet per
# STARTTLS um. Verwechselt man das, kommt kein Fehler — die Verbindung hängt,
# bis der Timeout zuschlägt. SMTP_SECURE nur setzen, um das zu übersteuern.
#
# ⚠️ NICHT über ein Freemail-Konto (web.de, GMX, Gmail, Yahoo): Ein Rundruf sind
# sieben fast gleiche Mails binnen Sekunden — genau das Missbrauchsmuster. Dazu
# kein eigenes SPF/DKIM und kein Bounce-Handling; landet eine Terminanfrage im
# Spam, merkt es niemand und die Reinigung fällt aus.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=
# Abweichender Absender; sonst gilt NOTIFY_FROM_EMAIL.
# SMTP_FROM=

# --- Smoobu (Phase 2, über das HMAC-Gateway aus dem gg-Repo) ---
SMOOBU_GATEWAY_URL=http://127.0.0.1:4500

# --- Bootstrap ---
# Legt beim ersten Start einen Demo-Mandanten mit Beispieldaten an — zum
# Ausprobieren nuetzlich, fuer einen echten Betrieb ueberfluessig.
# ⚠️ Standard ist AUS. Der Demo-Mandant laesst sich ohne Passwort betreten
# (ein Klick auf der Anmeldeseite); das ist auf unserem Schaufenster gewollt,
# auf deiner Instanz eher nicht.
BOOTSTRAP_DEMO=0

# --- Rechnungs-Stammdaten (nur fuer den Betreiberbereich) ---
# Nur noetig, wenn du mit Putzflow selbst Rechnungen an Mandanten stellst.
# Wer Putzflow fuer den eigenen Betrieb nutzt, braucht diesen Block nicht.
# ⚠️ § 14 Abs. 4 Nr. 2 UStG: Steuernummer ODER USt-IdNr. ist Pflicht — fehlt
# beides, kann der Empfaenger die Vorsteuer nicht ziehen.
RECHNUNG_FIRMA=Musterbetrieb GmbH
RECHNUNG_MARKE=Putzflow
RECHNUNG_STRASSE=Musterstr. 1
RECHNUNG_PLZ=40210
RECHNUNG_ORT=Duesseldorf
RECHNUNG_LAND=Deutschland
RECHNUNG_TELEFON=
RECHNUNG_EMAIL=
RECHNUNG_WEBSITE=
RECHNUNG_GF=
RECHNUNG_REGISTER=
RECHNUNG_STEUERNR=
RECHNUNG_USTID=
RECHNUNG_BANK=
RECHNUNG_IBAN=
RECHNUNG_BIC=
